import jks, sys, os, time, numpy as np
if len(sys.argv) != 7:
    print("%s database.jks tag_in list_of_weights_in list_of_weights_out omega_grid tag_out" % sys.argv[0])
    print("")
    print("- list_of_weights_X accepts a list of")
    print("  a) in integer t for which exp(-t*omega) will be used as the spectral weight")
    print("  b) a string tag to a weight")
    print("")
    print("- Note that an error on omega_grid is not propagated, use multiple omega_grid if needed")
    sys.exit(0)

db, tag_in, list_w_in, list_w_out, omega_grid, tag_out = sys.argv[1:]

res = jks.resamples(db)

omega_grid_arr = res.get(omega_grid).mean()
grid_tag = omega_grid

print(f"Performing positivity bounds using energy grid [{min(omega_grid_arr)},..,{max(omega_grid_arr)}] ({len(omega_grid_arr)} resolution)")

def process_weight_element(e, i):
    if isinstance(e, int):
        return np.exp(-e*omega_grid_arr), e
    elif isinstance(e, str):
        ww = res.get(e).mean()
        assert ww.shape == omega_grid_arr.shape, f"{e} not found"
        return ww, i
    else:
        assert False, "weight not found"

def process_weight(w):
    assert isinstance(w, list)
    t = [process_weight_element(e, i) for i, e in enumerate(w)]
    return [x[0] for x in t], [x[1] for x in t]

list_w_in, sel_w_in = process_weight(eval(list_w_in))
list_w_out, sel_w_out = process_weight(eval(list_w_out))

list_w_in = np.asarray(list_w_in, float)
list_w_out = np.asarray(list_w_out, float)

# create a temporary version of c_in projected
def get_c_in(r):
    raw_in = r[tag_in]
    return [ raw_in[s] for s in sel_w_in ]

c_in = res.apply(get_c_in)
c_in_mn = c_in.mean()

# full input covariance (the diagonal-only version mis-states the tension by
# O(1) on correlated data, e.g. lqcd: chi_min 1.09 (diag) vs 1.80 (full))
c_in_cv = np.array(c_in.cov())
# TODO: diagonal
c_in_cv = np.diag(c_in_cv.diagonal())

chi2 = 1.0

# --- tension between the data and positivity ---------------------------------
# exact (NNLS), not the faceted lower bound of the old min_chi
chi_min_in = jks.positive_laplace.min_chi_exact(list_w_in, c_in_mn, c_in_cv, omega_grid_arr,
                                                floor=None)
# A nonzero chi_min is the NORMAL state, not a red flag: a correlator dominated by
# its ground state sits close to the boundary of the moment cone (a single
# exponential is an extreme ray of it), so an ordinary sub-sigma fluctuation of the
# central value lands outside.  What matters is whether chi^2_min is comparable to
# the chi^2 being used: only then is the admissible set a thin cap.
# The record band is evaluated at chi_r: the requested chi if it is feasible and
# >= 1, else just outside the cone (the chi=1 band is the natural 1-sigma band,
# but it does not exist for data off the cone).
chi_user = chi2 ** 0.5 if chi2 > 0 else 1.0
chi_floor = 1.05 * chi_min_in
chi_r = max(chi_user, chi_floor)
ratio_cap = chi_min_in ** 2 / chi_r ** 2
print(f"Positivity tension: chi_min = {chi_min_in:.4f}  (chi^2_min = {chi_min_in**2:.4f}, "
      f"{ratio_cap:.1%} of record chi2 {chi_r**2:g})")
print(f"Record chi = {chi_r:.4f}  (requested chi2={chi2:g}"
      + (f"; raised by the feasibility floor 1.05*chi_min={chi_floor:.4f})"
         if chi_r > chi_user + 1e-12 else ")"))
if chi_min_in == 0.0:
    print(" the data are reproduced exactly by a positive spectrum on this grid")
elif ratio_cap <= 0.1:
    print(" small next to chi2 -- consistent with ordinary noise on the central value")
else:
    print(f" the data lie {chi_min_in:.3f} sigma outside the positive cone; the")
    print(f" admissible set at record chi2={chi_r**2:g} is a spherical cap.  Raise chi2 (e.g. to")
    print(f" ~{(chi_min_in + 1.0)**2:.0f}) if the quoted bands look narrow, or check")
    print(f" whether the tension is structural: if chi_min jumps when an input")
    print(f" weight is added, the window cannot fit it rather than it being noise.")
    print(f"NOTE: for N~30 resamples, chi2 < ~9 makes ~10% of datasets infeasible.")
print("")

# --- exact admissible range of every output weight (deterministic) -----------
t0 = time.time()
lo, hi, M, info = jks.positive_laplace.positivity_bounds(
    list_w_in, c_in_mn, c_in_cv, list_w_out, omega_grid_arr,
    chi=chi_r, floor=None)
t1 = time.time()
io = len(list_w_out)

bad = [j for j in range(io) if info["status"][j] not in ("ok", "zero_kernel")]
if bad:
    for j in bad:
        st = info["status"][j]
        if st in ("unbounded_hi", "unbounded_lo", "unbounded"):
            print(f"ERROR: output weight {sel_w_out[j]!r} is UNBOUNDED under positivity "
                  f"(status {st}): the data weights leave a free direction in the "
                  f"spectrum (a grid node no input weight sees, or input weights that "
                  f"cancel on part of the grid) and this output weight is nonzero along it.")
        else:
            print(f"ERROR: output weight {sel_w_out[j]!r}: dual status {st} (no band) -- "
                  f"raise chi2 (chi_min={chi_min_in:.3f}) or check the inputs.")
    print("  Refusing to store non-finite values in the database.")
    sys.exit(1)
central = 0.5 * (lo + hi)
half = 0.5 * (hi - lo)
# 1-sigma statistical error of the central value, LINEARIZED (M = slope of the
# band center): shown for reference; the stored blocks use the EXACT center.
stat_lin = np.sqrt(np.clip(np.einsum("ja,ab,jb->j", M, c_in_cv, M), 0.0, None))

print(f"Admissible range computed in {t1 - t0:.2f} s (max certificate violation "
      f"{max(v for v in info['violation_rel'] if v == v):.1e} relative)")
print("")

# --- store: central = band midpoint; stat blocks = the EXACT band center at
# each jackknife resample (the linearized M @ delta overstates the wobble where
# positivity clips, by up to an order of magnitude); the band itself as a single
# '!band' variation whose shift is the half-width, so
# [central - shift, central + shift] = [lo, hi].
holder = {"hints": info["hints"], "fallback": 0}

def get_c_out(r):
    c_r = np.array(get_c_in(r))
    m_r, ok, holder["hints"] = jks.positive_laplace.band_center(
        list_w_in, c_r, c_in_cv, list_w_out, omega_grid_arr, chi_r,
        hints=holder["hints"])
    m_lin = central + M @ (c_r - c_in_mn)   # fallback where the resample band is empty
    holder["fallback"] += int((~ok).sum())
    return np.where(ok, m_r, m_lin)

jk = res.apply(get_c_out)
stat = np.sqrt(np.clip(np.array(jk.cov()).diagonal(), 0.0, None))   # exact, from the blocks

if holder["fallback"]:
    print(f"note: {holder['fallback']} (resample, output) centers fell back to the")
    print(f"      linearized slope: the band is empty at that resample's data")
    print(f"      (chi_min(resample) > record chi = {chi_r:.3f}); expected for small N.")
    print("")

print(" out    central        stat(exact)  half-width   stat/hw")
for j in range(io):
    s = f" {sel_w_out[j]!s:>6}  {central[j]: .5e}  {stat[j]: .3e}  {half[j]: .3e}  "
    s += f"{stat[j] / half[j]:6.2f}" if half[j] > 0 else "    -"
    # stat/hw ~ 1: stable center, data-dominated;  stat/hw >> 1: the band center
    # is a hypersensitive functional of the data (free/cap direction) -- quote
    # the band, not the central value
    s += "   [band-dominated]" if (not np.isnan(central[j])) and half[j] > 0 and stat[j] > 1.5 * half[j] else ""
    print(s)
print("")
print(" stat is the exact per-resample wobble of the band center (jackknife);")
print(" half-width is the model band at record chi (stored as the '!band' shift);")
print(" [band-dominated] marks outputs whose center wobbles more than the band is")
print(" wide -- there the band (central +- half-width) is the answer, not the center.")
print("")

desc = ("Model-band half-width at record chi (range = central +- shift): positivity "
        "bounds via dual certificate, record chi2=%g (chi_min=%.3f), omega grid tag "
        "'%s' [%g..%g] x %d nodes, full input covariance, deterministic.  stat blocks "
        "= exact band center per resample (linearized fallback in %d cases).  "
        "Input weights: %s"
        % (chi_r ** 2, chi_min_in, grid_tag, min(omega_grid_arr), max(omega_grid_arr),
           len(omega_grid_arr), holder["fallback"], sel_w_in))
jk = jk.addvar("band", central + half, desc)
res.add(tag_out, jk)

res.save(db)

print("Done")
